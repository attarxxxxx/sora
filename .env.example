# Neon pooled connection string (used by Prisma Client at runtime)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection string (used by Prisma CLI for migrations)
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Local app URL
BETTER_AUTH_URL="http://localhost:3000"
